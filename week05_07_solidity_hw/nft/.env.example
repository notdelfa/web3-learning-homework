# Sepolia RPC（公共节点易限流；推荐 Alchemy/Infura 免费 key）
# 备选：https://gateway.tenderly.co/public/sepolia  https://1rpc.io/sepolia  https://sepolia.drpc.org
SEPOLIA_RPC_URL=https://gateway.tenderly.co/public/sepolia

# 部署账户私钥（勿提交真实私钥；推荐改用 hardhat keystore）
SEPOLIA_PRIVATE_KEY=

# 可选：uups | transparent | both（默认 uups）
# DEPLOY_MODE=uups
